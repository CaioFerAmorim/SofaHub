{
  "manifest_version": 3,
  "name": "SofaHub",
  "version": "0.7.3",
  "description": "Controle remoto pelo celular: navegação por setas, player e tela cheia.",
  "background": {
    "service_worker": "sw-sofahub-060.js"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "cursor.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "player-api.js"
      ],
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "icon-128.png"
  }
}
